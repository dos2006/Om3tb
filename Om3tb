                end)
                return true
            end
        end
    end
    
    local Events = ReplicatedStorage:FindFirstChild("Events")
    if Events then
        local SendMessage = Events:FindFirstChild("SendMessage")
        if SendMessage then
            pcall(function()
                SendMessage:FireServer(command)
